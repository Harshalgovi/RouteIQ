# RouteIQ Backend Environment Variables
APP_NAME=RouteIQ
APP_ENV=development
VERSION=0.1.0
DEBUG=True
API_V1_STR=/api/v1

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration
# Default to SQLite for easy zero-setup local dev; update to PostgreSQL for production
# PostgreSQL (psycopg v3):  postgresql+psycopg://user:pass@localhost:5432/routeiq_db
# PostgreSQL (psycopg2):    postgresql+psycopg2://user:pass@localhost:5432/routeiq_db
DATABASE_URL=sqlite:///./routeiq.db

# ─────────────────────────────────────────────────────────────────────────────
# MAP PROVIDER (real basemap tiles — resolved by app/services/maps)
# ─────────────────────────────────────────────────────────────────────────────
MAP_PROVIDER=openstreetmap
MAP_DEFAULT_STYLE=dark
# Default viewport: Bengaluru, Karnataka, India.
MAP_DEFAULT_LATITUDE=12.9716
MAP_DEFAULT_LONGITUDE=77.5946
MAP_DEFAULT_ZOOM=11

# ─────────────────────────────────────────────────────────────────────────────
# GEOCODING PROVIDER (address -> lat/lng — resolved by app/services/geocoding)
# ─────────────────────────────────────────────────────────────────────────────
# Nominatim is keyless. No API key required.
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# GEOCODING_API_KEY=
# Nominatim policy: identify your app. Change this if you deploy RouteIQ.
GEOCODING_USER_AGENT=RouteIQ/1.0 (delivery routing platform)
GEOCODING_LANGUAGE=en
# GEOCODING_COUNTRY_CODES=in
GEOCODING_TIMEOUT_SECONDS=10
GEOCODING_MIN_INTERVAL_SECONDS=1
GEOCODING_CACHE_TTL_SECONDS=86400
GEOCODING_CACHE_MAX_ENTRIES=2048

# ─────────────────────────────────────────────────────────────────────────────
# ROUTING PROVIDER (lat/lng -> distance/duration/geometry — app/services/routing)
# ─────────────────────────────────────────────────────────────────────────────
# OSRM demo server is keyless. Self-host for production traffic.
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://router.project-osrm.org
# ROUTING_API_KEY=
ROUTING_PROFILE=driving
ROUTING_TIMEOUT_SECONDS=12
ROUTING_MIN_INTERVAL_SECONDS=0
ROUTING_CACHE_TTL_SECONDS=900
ROUTING_CACHE_MAX_ENTRIES=1024
